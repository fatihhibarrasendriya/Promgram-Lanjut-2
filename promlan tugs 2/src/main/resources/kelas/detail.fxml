<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Detail Produk Toko" />
            <Button onAction="#bukaDaftar" styleClass="button-secondary" text="Kembali ke Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="muted" text="KODE PRODUK" />
                        <Label fx:id="kodeLabel" styleClass="subtitle" />

                        <Label styleClass="muted" text="NAMA PRODUK" />
                        <Label fx:id="namaLabel" styleClass="title-small" wrapText="true" />

                        <Label styleClass="muted" text="KATEGORI" />
                        <Label fx:id="kategoriLabel" styleClass="subtitle" />

                        <Label styleClass="muted" text="HARGA" />
                        <Label fx:id="hargaLabel" styleClass="price-tag" />

                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />

                        <HBox spacing="10">
                            <Button onAction="#tambah" styleClass="button-primary" text="+ Tambah Produk Lain" />
                            <Button onAction="#bukaDaftar" styleClass="button-secondary" text="Lihat Semua Daftar" />
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
