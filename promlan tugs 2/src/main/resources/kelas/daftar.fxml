<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="14" styleClass="header">
            <Label styleClass="title" text="Daftar Produk Toko" />
            <HBox spacing="10">
                <TextField fx:id="cariField" onAction="#cari" promptText="Cari nama produk..." HBox.hgrow="ALWAYS" />
                <Button onAction="#cari" text="Cari" />
                <Button onAction="#resetPencarian" styleClass="button-secondary" text="Reset" />
                <Button onAction="#tambah" styleClass="button-primary" text="+ Tambah Produk" />
                <Button onAction="#detail" styleClass="button-info" text="Lihat Detail" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox styleClass="page">
            <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="kodeCol" prefWidth="120" text="Kode" />
                    <TableColumn fx:id="namaCol" prefWidth="300" text="Nama Produk" />
                    <TableColumn fx:id="kategoriCol" prefWidth="150" text="Kategori" />
                    <TableColumn fx:id="hargaCol" prefWidth="180" text="Harga" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="footer">
            <Label fx:id="pesanLabel" styleClass="muted" wrapText="true" />
        </HBox>
    </bottom>
</BorderPane>
