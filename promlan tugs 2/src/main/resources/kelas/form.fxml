<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Form Tambah Produk" />
            <Button onAction="#bukaDaftar" styleClass="button-secondary" text="Kembali ke Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="14" styleClass="card">
                        <Label styleClass="subtitle" text="Informasi Produk" />
                        
                        <VBox spacing="6">
                            <Label styleClass="label-bold" text="Nama Produk" />
                            <TextField fx:id="namaField" promptText="Contoh: Nasi Goreng Spesial" />
                        </VBox>

                        <VBox spacing="6">
                            <Label styleClass="label-bold" text="Kategori" />
                            <ComboBox fx:id="kategoriBox" maxWidth="Infinity" />
                        </VBox>

                        <VBox spacing="6">
                            <Label styleClass="label-bold" text="Harga Produk (Rp)" />
                            <TextField fx:id="hargaField" promptText="Contoh: 25000" />
                        </VBox>

                        <Label styleClass="muted" text="Catatan: Kode produk dibuat otomatis oleh sistem (PR001, PR002, dll)." wrapText="true" />

                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan Produk" />
                        
                        <Label fx:id="pesanLabel" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
